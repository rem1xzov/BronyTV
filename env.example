# Copy to .env next to docker-compose.yml (no quotes, no spaces around values).
POSTGRES_USER=postgres
POSTGRES_PASSWORD=
POSTGRES_DB=BronyTV

# Origin allowed to send credentialed requests (session cookie).
FRONTEND_ORIGIN=https://bronytv.ru
# Local dev: FRONTEND_ORIGIN=http://localhost:8080

# JWT signing key (generate, for example: openssl rand -base64 48).
# The same key is injected into the API and AI containers by docker-compose.
JWT_KEY=

# Optional legacy /api/auth/login bootstrap (normal admins use verified user accounts).
# If enabled, use a unique password of at least 12 characters.
ADMIN_BOOTSTRAP_LOGIN=
ADMIN_BOOTSTRAP_PASSWORD=

# Verified email accounts that receive platform roles after confirmation.
# Do not assign roles by username: usernames are public registration input.
OWNER_EMAIL=b.kravtsov09@gmail.com
ADMIN_EMAIL=b.programc@gmail.com

# Email verification / SMTP. Keep the app password only in .env or a deployment secret;
# never commit it. SmtpUseSsl=true means explicit STARTTLS in MailKit.
EMAIL_SMTP_HOST=smtp.gmail.com
EMAIL_SMTP_PORT=587
EMAIL_SMTP_USER=b.bronytv@gmail.com
EMAIL_SMTP_PASSWORD=wubu jcxv qnln yqqz
EMAIL_SMTP_USE_SSL=true
EMAIL_FROM_ADDRESS=b.bronytv@gmail.com
EMAIL_SENDER_NAME=BronyTV

# BronyVPN (3X-UI integration).
# Set VPN_ENABLED=true to reveal the VPN section to users.
VPN_ENABLED=false
# Public VLESS server host:port (for the connection link).
VPN_SERVER_HOST=vpn.bronytv.ru
VPN_SERVER_PORT=443
# Query parameters appended to the VLESS link (e.g. security=reality&sni=...).
VPN_VLESS_PARAMETERS=
# Base URL of the 3X-UI panel (for the client cabinet link).
VPN_PANEL_BASE_URL=https://panel.bronytv.ru:2053
# Full API URL of the 3X-UI panel (base address used for /panel/api/... + webhook secret path).
VPN_PANEL_API_URL=https://panel.bronytv.ru:2053/7qnuZemfecK2G5HUT7/panel
# Bearer API-token of the 3X-UI panel. REQUIRED — provisioning of VPN clients
# depends on it. Without it the panel integration is considered unconfigured and
# trial/promo activation will fail with an explicit 5xx (never a silent broken link).
# Generate it in the panel (Settings -> API), e.g:
#   openssl rand -base64 48
VPN_PANEL_API_TOKEN=
# Inbound (VLESS) id on 3X-UI where clients are added (optional, falls back to first VLESS inbound).
VPN_PANEL_INBOUND_ID=
# Domain where clients can be downloaded.
VPN_CLIENT_DOMAIN=clients.bronytv.ru
# Trial duration in days (default 14).
VPN_TRIAL_DAYS=14

# AI Bot microservice (DeepSeek / OpenAI-compatible LLM).
DEEPSEEK_API_KEY=
DEEPSEEK_ENDPOINT=https://api.deepseek.com/v1
DEEPSEEK_MODEL=deepseek-chat

# Shared secret protecting server-to-server activity endpoints (BronyTV <-> AiBronyTV).
# Generate with: openssl rand -base64 48
BRONYTV_INTERNAL_KEY=

