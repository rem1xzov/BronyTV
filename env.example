# Copy to .env next to docker-compose.yml (no quotes, no spaces around values).
POSTGRES_USER=postgres
POSTGRES_PASSWORD=G8#qT!p
POSTGRES_DB=BronyTV

# Origin allowed to send credentialed requests (session cookie).
FRONTEND_ORIGIN=https://bronytv.ru
# Local dev: FRONTEND_ORIGIN=http://localhost:8080

# JWT signing key (use a long random string in production).
JWT_KEY=change-me-in-production

# Email / SMTP (optional; if empty the app logs and skips sending).
EMAIL_SMTP_HOST=
EMAIL_SMTP_PORT=587
EMAIL_SMTP_USER=
EMAIL_SMTP_PASSWORD=
EMAIL_SMTP_USE_SSL=true
EMAIL_FROM_ADDRESS=no-reply@bronytv.ru
EMAIL_SENDER_NAME=BronyTV

# AI Bot microservice (DeepSeek / OpenAI-compatible LLM).
DEEPSEEK_API_KEY=
DEEPSEEK_ENDPOINT=https://api.deepseek.com/v1
DEEPSEEK_MODEL=deepseek-chat
